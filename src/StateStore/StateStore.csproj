<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>StateStore</RootNamespace>
    <AssemblyName>StateStore</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- NuGet-specific properties for Release builds -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>StateStore</PackageId>
    <Version>1.0.0</Version>
    <Authors>Cadtastic Solutions</Authors>
    <Company>Cadtastic Solutions</Company>
    <Description>Flexible, testable state storage library for .NET supporting multiple providers and middleware.</Description>
    <PackageTags>state;storage;middleware;dotnet;testable</PackageTags>
    <RepositoryUrl>https://github.com/Cadtastic-Solutions/StateStore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Cadtastic-Solutions/StateStore</PackageProjectUrl>
    <!-- Add other NuGet properties here as needed -->
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StateStore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="readme.md" Pack="true" PackagePath="docs/readme.md" />
    <None Include=".Docs\*.md" Pack="true" PackagePath="docs/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <!--
      Microsoft.Data.Sqlite 10.0.12+ depends on SQLitePCLRaw 2.1.12, whose native lib ships SQLite 3.53.3.
      Earlier versions pulled SQLitePCLRaw.lib.e_sqlite3 2.1.11 (SQLite 3.49.1), flagged by NuGet audit
      as NU1903 for CVE-2025-6965 / GHSA-2m69-gcr7-jv3q (SQLite < 3.50.2 memory corruption).
      Do not downgrade below 10.0.12 without re-checking the audit.
    -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="MongoDB.Driver" Version="3.8.1" />
  </ItemGroup>

</Project>
